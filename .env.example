# Copie este arquivo para .env e ajuste os valores.
# Dev (Docker): use o usuario/senha do docker-compose.yml
# Mercado (Postgres Windows): use o usuario/senha que voce criou na instalacao

# Exemplo Docker (padrao do projeto):
DATABASE_URL="postgresql://pdv:pdv_secret@localhost:5432/pdv_mercado?schema=public"

# Exemplo Postgres instalado no Windows:
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/pdv_mercado?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
