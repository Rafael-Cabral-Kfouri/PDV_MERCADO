// Schema do PDV Mercado — Prompt 1
// Models: User, Product, Sale, SaleItem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum SaleStatus {
  CONCLUIDA
  CANCELADA
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  funcao    Role
  cpf       String?  @unique
  rg        String?
  telefone  String?
  endereco  String?
  vendas    Sale[]
  criadoEm  DateTime @default(now())
}

model Product {
  id                String     @id @default(cuid())
  codigoBarras      String     @unique
  nome              String
  precoUnitario     Decimal    @db.Decimal(10, 2)
  quantidadeEstoque Int        @default(0)
  /// Caminho público opcional, ex.: /uploads/produtos/abc.jpg
  fotoUrl           String?
  criadoEm          DateTime   @default(now())
  itensVenda        SaleItem[]
}

model Sale {
  id             String         @id @default(cuid())
  codigoVenda    String         @unique
  dataVenda      DateTime       @default(now())
  total          Decimal        @db.Decimal(12, 2)
  formaPagamento PaymentMethod?
  status         SaleStatus     @default(CONCLUIDA)
  operadorId     String
  operador       User           @relation(fields: [operadorId], references: [id])
  itens          SaleItem[]
}

model SaleItem {
  id            String  @id @default(cuid())
  vendaId       String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  precoTotal    Decimal @db.Decimal(12, 2)
  venda         Sale    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto       Product @relation(fields: [produtoId], references: [id])
}

/// Configuração única do estabelecimento (recibo / impressão).
model StoreSettings {
  id                  String  @id @default("default")
  nomeEstabelecimento String  @default("PDV Mercado")
  cnpj                String  @default("")
  endereco            String  @default("")
  mensagemRodape      String  @default("Obrigado pela preferência! Volte sempre.")
  imprimirAutomatico  Boolean @default(false)
  atualizadoEm        DateTime @updatedAt
}
